rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Check if user is member via 'members' subcollection OR if it's their own personal family (familyId == uid)
    function isFamilyMember(familyId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)) ||
        familyId == request.auth.uid
      );
    }

    // Check if user is admin via 'members' subcollection role OR if it's their own personal family
    function isFamilyAdmin(familyId) {
      return isSignedIn() && (
        (isFamilyMember(familyId) && get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role == 'admin') ||
        familyId == request.auth.uid
      );
    }

    // --- Collection Rules ---

    // 1. Users Collection
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 2. Families Collection
    match /families/{familyId} {
      // Allow getting a specific family document (needed for "Join Family" existence checks)
      allow get: if isSignedIn();
      
      // Allow listing families only if you are a member (though usually you list via your user profile)
      allow list: if isFamilyMember(familyId);
      
      allow create: if isSignedIn();
      allow update: if isFamilyAdmin(familyId);
      allow delete: if isFamilyAdmin(familyId);

      // 2a. Members Subcollection
      match /members/{memberId} {
        allow read: if isFamilyMember(familyId) || resource.data.inviteEmail == request.auth.token.email;
        
        // Admins can manage members. 
        // Also allow a user to remove THEMSELVES (Leave Family)
        // AND allow a user to delete a pending invite sent to them (Join/Reject flow)
        allow create, update: if isFamilyAdmin(familyId);
        allow delete: if isFamilyAdmin(familyId) || 
                      request.auth.uid == memberId || 
                      resource.data.inviteEmail == request.auth.token.email;
      }

      // 2b. Items Subcollection
      match /items/{itemId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId) && request.resource.data.ownerId == request.auth.uid;
        allow update, delete: if isFamilyAdmin(familyId) || 
                              (isFamilyMember(familyId) && resource.data.ownerId == request.auth.uid);
      }
      
      // 2c. Locations Subcollection
      match /locations/{locationId} {
         allow read: if isFamilyMember(familyId);
         allow write: if isFamilyAdmin(familyId);
      }
    }

    // 3. Collection Group Queries
    // explicit match for collection group queries on 'members' to find invites
    match /{path=**}/members/{memberId} {
      allow read: if isSignedIn() && resource.data.inviteEmail == request.auth.token.email;
    }
  }
}
